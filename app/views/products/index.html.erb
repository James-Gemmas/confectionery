<h1>Наши торты</h1>
<% @products.each do |product| %>
  <div style="border:1px solid #ccc; margin:10px; padding:10px; width: 300px; display: inline-block; vertical-align: top;">
    <% if product.image.attached? %>
      <%= image_tag product.image, style: "max-width: 100%; height: auto;" %>
    <% else %>
      <div style="background:#eee; height:150px; display:flex; align-items:center; justify-content:center;">Нет фото</div>
    <% end %>
    <h2><%= product.name %></h2>
    <p><%= product.description %></p>
    <% if product.weight.present? %>
      <p>Вес: <%= product.weight %> кг</p>
    <% end %>
    <% if product.cake_type.present? %>
      <p>Вид: <%= product.cake_type %></p>
    <% end %>
    <p><strong>Цена: <%= product.price %> руб.</strong></p>
    <%= button_to 'В корзину', cart_path(product_id: product.id, quantity: 1), method: :patch %>
  </div>
<% end %>
<p><%= link_to 'Корзина', cart_path %> | <%= link_to 'Мои заказы', orders_path %></p>